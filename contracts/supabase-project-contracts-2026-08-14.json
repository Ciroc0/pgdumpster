        "organization_id": {
          "type": "string",
          "description": "Deprecated: Use `organization_slug` instead.",
          "deprecated": true
        },
        "organization_slug": {
          "type": "string",
          "pattern": "^[\\w-]+$",
          "description": "Organization slug",
          "example": "tsrqponmlkjihgfedcba"
        },
        "name": {
          "type": "string",
          "description": "Name of your project"
        },
        "region": {
          "type": "string",
