{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pgdumpster:schema:restore-plan:1",
  "title": "pgDumpster Restore Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "createdAt",
    "source",
    "target",
    "conflictPolicy",
    "allowBillableResources",
    "status",
    "actions",
    "manualActions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "planId": { "type": "string", "format": "uuid" },
    "createdAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectRef", "backupOperationId", "backupResult"],
      "properties": {
        "projectRef": { "type": "string", "pattern": "^[a-z0-9]{20}$" },
        "backupOperationId": { "type": "string", "format": "uuid" },
        "backupResult": {
          "enum": ["complete", "complete_with_platform_limits"]
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectRef"],
      "properties": {
        "projectRef": { "type": "string", "pattern": "^[a-z0-9]{20}$" }
      }
    },
    "conflictPolicy": { "enum": ["fail", "replace"] },
    "allowBillableResources": { "type": "boolean" },
    "status": { "enum": ["ready", "ready_with_platform_limits", "blocked"] },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "component",
          "phase",
          "operation",
          "risk",
          "billable",
          "dependsOn",
          "status",
          "sourceStatus",
          "restorePolicy",
          "fidelity",
          "artifacts"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^restore\\.[a-z0-9_.-]+$" },
          "component": { "type": "string", "minLength": 1 },
          "phase": { "type": "integer", "minimum": 1, "maximum": 21 },
          "operation": { "type": "string", "minLength": 1 },
          "risk": {
            "enum": ["none", "inspection", "mutation", "destructive", "manual"]
          },
          "billable": { "type": "boolean" },
          "dependsOn": { "type": "array", "items": { "type": "string" } },
          "status": {
            "enum": [
              "planned",
              "skipped",
              "blocked_by_policy",
              "blocked_platform_limit",
              "blocked_source_failure"
            ]
          },
          "sourceStatus": {
            "enum": [
              "backed_up",
              "not_configured",
              "not_applicable",
              "not_exportable",
              "failed"
            ]
          },
          "restorePolicy": { "type": "string", "minLength": 1 },
          "fidelity": {
            "enum": [
              "exact",
              "semantic",
              "replacement",
              "manual",
              "not_applicable"
            ]
          },
          "artifacts": { "type": "array", "items": { "type": "string" } },
          "reasonCode": { "type": "string", "minLength": 1 }
        }
      }
    },
    "manualActions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "component", "reasonCode", "message"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "component": { "type": "string", "minLength": 1 },
          "reasonCode": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
